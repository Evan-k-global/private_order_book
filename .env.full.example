DEPLOYER_PRIVATE_KEY=EKF_replace_with_sepolia_deployer_private_key
ZKAPP_PRIVATE_KEY=EKF_replace_with_deployed_zkapp_private_key
ZKAPP_PUBLIC_KEY=B62qpDKEh2xPWQL7syCFQkypgRqwHo1P4QxgqahwkcTvJzEL3DU9MJv
OPERATOR_PUBLIC_KEY=B62qp9NMiEKE9wAYdJ3W6suBLEJZkHnVAfSBo9reD2ymwB8KDDafXTu
OPERATOR_PANEL_ADMIN_KEY=replace-with-operator-admin-key
PAYOUT_OPERATOR_PRIVATE_KEY=EKF_replace_with_payout_operator_private_key
PAYOUT_FEE_PAYER_PRIVATE_KEY=EKF_replace_with_optional_fee_payer_private_key
VAULT_DEPOSIT_ADDRESS=B62q_replace_with_sepolia_vault_address

DARKPOOL_HOST=0.0.0.0
DARKPOOL_PORT=8791
DARKPOOL_DATA_DIR=data/zeko-sepolia
ORDER_RECEIPT_SECRET=replace-with-random-receipt-secret
INTERNAL_SERVICE_SECRET=replace-with-random-internal-service-secret
ORDER_STATE_ENCRYPTION_KEY=replace-with-random-engine-state-key
WALLET_HASH_SALT=replace-with-random-wallet-hash-salt
RESET_OPEN_ORDERS_ON_BOOT=false

REQUIRE_ONCHAIN_DEPOSIT_TX=true
ALLOW_WALLET_TX_HASH_FALLBACK=true
ONCHAIN_SYNC_TTL_MS=60000
MAKER_API_KEY=replace-with-maker-api-key
TAKER_FEE_BPS=5
FRONTEND_FEE_SHARE_BPS=3000
MARKET_ORDER_SLIPPAGE_BPS=100
GTC_ORDER_EXPIRY_MS=0

AUTO_RUN_BACKGROUND_WORKERS=false
AUTO_RUN_PROOF_WORKER=false
AUTO_RUN_SETTLEMENT_WORKER=false
AUTO_SETTLEMENT=false
ENABLE_LOCAL_SETTLEMENT=false
AUTO_SETTLEMENT_INTERVAL_MS=5000
BACKGROUND_WORKER_RESTART_DELAY_MS=3000
SETTLEMENT_MODE=zkapp
SETTLEMENT_INTERVAL_MS=6000
SETTLEMENT_BATCH_MAX_TRADES=8
SETTLEMENT_BATCH_MAX_DELAY_MS=10000
SETTLEMENT_REQUIRE_ONCHAIN_PAYOUTS=true
SETTLEMENT_REQUIRE_PAYOUT_PROOFS=true
SETTLEMENT_ALLOW_UNVERIFIED_PAYOUTS=false
SETTLEMENT_PROCEEDS_AS_NOTES=true
SETTLEMENT_PAYOUT_COMMAND="node scripts/settlement-payout-executor.js"
ZEKO_SETTLEMENT_GRAPHQL=https://sepolia.zeko.io/graphql

PROOF_WORKER_API_KEY=replace-with-proof-worker-api-key
PRIVATE_STATE_PROOF_INTERVAL_MS=4000
PRIVATE_STATE_PROOF_COMMAND="node --enable-source-maps dist-zkapp/prove-private-state-batch.js"
ZKAPP_COMMIT_COMMAND="node --enable-source-maps dist-zkapp/commit-next-batch.js"
ZKAPP_COMMIT_USE_PROOF=true
REQUIRE_CACHED_PRIVATE_STATE_PROOF=true
ALLOW_INLINE_PRIVATE_STATE_PROVING=false
ZKAPP_COMMIT_MAX_OLD_SPACE_MB=12288
PRIVATE_STATE_PROVER_MAX_OLD_SPACE_MB=8192
ZKAPP_DEPLOY_MAX_OLD_SPACE_MB=12288

DA_MODE=zeko-relay
DA_ENDPOINT=http://127.0.0.1:8787/publish
DA_BEARER_TOKEN=replace-with-da-bearer-token
DA_REQUIRE_ENCRYPTION=true
DA_INCLUDE_ORDER_SNAPSHOT=false
DA_ENCRYPTION_KEY=replace-with-random-da-encryption-key
ZEKO_DA_NETWORK=zeko:testnet
ZEKO_DA_APP_ID=shadowbook
ZEKO_DA_SCHEMA=shadowbook.da.v1
DA_RELAY_PORT=8787
DA_RELAY_FORWARD_MODE=none
ZEKO_DA_BRIDGE_URL=https://replace-with-da-bridge/publish
ZEKO_DA_BRIDGE_TOKEN=replace-with-da-bridge-token
ZEKO_DA_NAMESPACE=shadowbook
ZEKO_DA_REQUIRE_FORWARD=false
DA_RELAY_FORWARD_RETRIES=3
DA_RELAY_FORWARD_TIMEOUT_MS=15000
DA_RELAY_COMMAND=
DA_RELAY_SECRET=replace-with-da-relay-secret
